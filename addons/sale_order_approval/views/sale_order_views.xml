<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sale_order_approval" model="ir.ui.view">
        <field name="name">sale.order.form.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_request_approval"
                    type="object"
                    string="Request Approval"
                    class="oe_highlight"
                    invisible="state not in ('draft', 'sent') or approval_status in ('waiting_manager', 'waiting_finance', 'waiting_gm', 'approved')"
                />
                <button
                    name="action_approve_order"
                    type="object"
                    string="Approve"
                    groups="sale_order_approval.group_sale_approval_manager,sale_order_approval.group_sale_approval_finance,sale_order_approval.group_sale_approval_gm"
                    invisible="state not in ('draft', 'sent') or approval_status not in ('waiting_manager', 'waiting_finance', 'waiting_gm')"
                />
                <button
                    name="action_reject_order"
                    type="object"
                    string="Reject"
                    class="btn-secondary"
                    groups="sale_order_approval.group_sale_approval_manager,sale_order_approval.group_sale_approval_finance,sale_order_approval.group_sale_approval_gm"
                    invisible="state not in ('draft', 'sent') or approval_status not in ('waiting_manager', 'waiting_finance', 'waiting_gm')"
                />
            </xpath>
            <xpath expr="//sheet//group" position="inside">
                <field
                    name="approval_status"
                    widget="badge"
                    decoration-success="approval_status == 'approved'"
                    decoration-warning="approval_status in ('waiting_manager', 'waiting_finance', 'waiting_gm')"
                    decoration-danger="approval_status == 'rejected'"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Approval History">
                    <field name="approval_log_ids" readonly="1">
                        <tree create="0" delete="0" edit="0">
                            <field name="action_date"/>
                            <field name="user_id"/>
                            <field name="action"/>
                            <field name="from_status"/>
                            <field name="to_status"/>
                            <field name="note"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
